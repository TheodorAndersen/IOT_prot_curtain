# TTN MQTT Credentials (required when TRANSPORT_MODE=ttn_mqtt)
MQTT_API_KEY=your-ttn-api-key
TTN_APPID=your-ttn-app-id
TTN_DEVID=your-ttn-device-id
TTN_REGION=eu1
# Optional MQTT overrides (for TTI custom tenants/hosts or local Mosquitto testing)
# TTN_TENANT=ttn
# TTN_MQTT_HOST=eu1.cloud.thethings.network
# TTN_MQTT_PORT=8883
# TTN_MQTT_USE_TLS=true
# TTN_MQTT_CA_CERTS=

# PostgreSQL (when POSTGRES_PASSWORD is set, the backend builds the DSN automatically)
POSTGRES_USER=curtain
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=curtain
# Optional bare-metal DSN override when POSTGRES_PASSWORD is not set:
# DATABASE_URL=postgresql://curtain:curtain@localhost:5432/curtain

# FastAPI Server
APP_HOST=127.0.0.1
APP_PORT=8000

# Transport & Protocol
TRANSPORT_MODE=ttn_mqtt
PROTOCOL_VERSION=v4
# Optional explicit protocol file path override (defaults to protocol.json for v4 or protocol.v3.json for v3):
# PROTOCOL_CONFIG_PATH=protocol.json
# Optional downlink handshake timeout override in seconds (defaults to 25 from protocol.json):
# HANDSHAKE_TIMEOUT_SEC=25
SYNC_ON_STARTUP=false

# Background Loop Intervals & Timezone
DISPATCH_POLL_SEC=2
SCHEDULER_POLL_SEC=10
SCHEDULE_TIMEZONE=Europe/Copenhagen

# Auth & Demo Seeding
TOKEN_TTL_HOURS=168
DEMO_USER_EMAIL=demo@example.com
# Website login password (optional; takes precedence over DEMO_USER_PASSWORD_MD5 when non-empty):
DEMO_USER_PASSWORD=curtain
# Or specify a precomputed lowercase MD5 hex digest (2805ba35a46fd703543fb61625cd9393 = md5("curtain")):
DEMO_USER_PASSWORD_MD5=2805ba35a46fd703543fb61625cd9393
DEVICE_NAME="Roller curtain"
DEVICE_DEV_EUI=0004A30B00E8F83E

# USB/TTN Debug Link (opt-in only; UI toggle appears in /debug). Off by default in production.
# In Docker (local or GCP), uncomment these 3 lines + set a strong password to start mosquitto & enable /debug switching:
# COMPOSE_PROFILES=usb-debug
# USB_MQTT_HOST=mosquitto
# USB_MQTT_PASSWORD=change-me-usb-password
# USB_MQTT_USERNAME=bridge
# USB_MQTT_PORT=1883
# Which link a fresh backend starts on when enabled (usb or ttn); the switch state is persisted afterwards.
LINK_DEFAULT=ttn
# Backend run bare-metal (uvicorn, no Docker) with local Mosquitto: set USB_MQTT_HOST=127.0.0.1
# Where usb_bridge/mqtt_usb_bridge.py connects (for hosted backend use wss://<DOMAIN>/mqtt):
# BRIDGE_SERVER=wss://curtain.example.com/mqtt

# Local Dev Ports (localhost-only)
NGINX_HTTP_PORT=8080

# GCP Production HTTPS (used by deploy/gcp/docker-compose.prod.yml & init-letsencrypt.sh)
DOMAIN=curtain.example.com
CERTBOT_EMAIL=you@example.com

# GCP Deployment Config (used by deploy/gcp/scripts/*; keep real values only in .env)
GCP_PROJECT=your-gcp-project
GCP_ROOT_DOMAIN=example.com
GCP_DNS_ZONE=example-com
GCP_REGION=europe-north2
GCP_ZONE=europe-north2-a
GCP_VM_NAME=curtain-vm
GCP_MACHINE_TYPE=e2-small
GCP_NETWORK_TAG=curtain-https
GCP_STATIC_IP_NAME=curtain-static-ip
GCP_STATIC_IP=
DEPLOY_REPO_URL=https://github.com/your-org/your-repo.git
DEPLOY_APP_DIR=/opt/iot_prot_curtain
VITE_API_BASE_URL=https://curtain.example.com/api
